# Dependencies / build
node_modules/
dist/
.vite/
*.tsbuildinfo

# alphaTab assets copied into public/ by @coderline/alphatab-vite at build time
app/public/font/
app/public/soundfont/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Content-addressed blob stores. These files are named by hash with NO
# extension, so the extension rules below cannot catch them. This repo is
# public: audio and tab blobs must never be committed.
blobs/
ingest/blobs/
ingest/data/
ingest/media/

# Third-party browser bundle the manager window copies out of the PWA's
# node_modules at startup (see manager_assets.py). A 1.1 MB build artifact
# belongs in neither this repo nor its history.
ingest/static/vendor/

# Python tooling noise
.pytest_cache/
*.egg-info/

# Content that must never be public: tabs, audio, ingest artifacts
*.gp
*.gp3
*.gp4
*.gp5
*.gpx
*.mid
*.musicxml
*.mxl
*.opus
*.mp3
*.m4a
*.m4p
*.flac
*.wav
*.ogg
*.sf2
*.sf3
ingest/*.db
ingest/*.db-*
ingest/output/
ingest/reports/
media/

# Local config with machine-specific paths
ingest/config.local.*
.env
.env.*

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store

# Vercel local link state (project/org ids)
.vercel/

# Scratch
scratch/
*.log

# Internal build brief - not part of the public repo
FABLE_PROMPT.md
